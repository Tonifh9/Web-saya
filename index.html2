
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEXORA | Personal Portfolio</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #070b14;
  --card: #101827;
  --blue: #2563eb;
  --neon: #38bdf8;
  --white: #f8fafc;
  --gray: #94a3b8;
  --border: #1e293b;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  background: var(--bg);
  color: var(--white);
  font-family: 'Inter', sans-serif;
  line-height: 1.7;
}

a {
  text-decoration: none;
  color: inherit;
}

button {
  font-family: inherit;
  cursor: pointer;
}

/* NAVBAR */

header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(7,11,20,.95);
  backdrop-filter: blur(15px);
  border-bottom: 1px solid var(--border);
}

nav {
  max-width: 1150px;
  margin: auto;
  padding: 18px 25px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 25px;
  font-weight: 800;
  letter-spacing: 3px;
  color: var(--neon);
}

.nav-links {
  display: flex;
  gap: 25px;
  list-style: none;
  font-size: 13px;
}

.nav-links a {
  color: var(--gray);
  transition: .3s;
}

.nav-links a:hover {
  color: var(--neon);
}

.cart-btn {
  border: 1px solid var(--blue);
  background: transparent;
  color: var(--neon);
  padding: 9px 17px;
  border-radius: 30px;
}

/* GENERAL */

.container {
  max-width: 1100px;
  margin: auto;
  padding: 90px 25px;
}

.label {
  color: var(--neon);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 3px;
}

h1, h2 {
  line-height: 1.2;
  font-weight: 800;
}

h2 {
  font-size: clamp(30px,5vw,43px);
  margin: 12px 0;
}

.description {
  color: var(--gray);
  max-width: 570px;
  font-size: 14px;
}

.primary-btn {
  display: inline-block;
  background: var(--blue);
  color: white;
  padding: 13px 25px;
  border-radius: 5px;
  margin-top: 25px;
  transition: .3s;
}

.primary-btn:hover {
  background: var(--neon);
  color: #070b14;
  transform: translateY(-3px);
}

/* HERO */

.hero {
  max-width: 1150px;
  min-height: 620px;
  margin: auto;
  padding: 70px 25px;
  display: flex;
  align-items: center;
  gap: 60px;
}

.hero-content {
  flex: 1;
}

.hero h1 {
  font-size: clamp(45px,7vw,75px);
  margin: 20px 0;
}

.hero h1 span {
  color: var(--neon);
}

.hero-image {
  flex: 1;
  height: 420px;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid var(--border);
  box-shadow: 0 0 40px rgba(37,99,235,.12);
}

.hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.stats {
  display: flex;
  gap: 35px;
  margin-top: 35px;
}

.stats strong {
  display: block;
  font-size: 20px;
  color: var(--neon);
}

.stats small {
  color: var(--gray);
  font-size: 11px;
}

/* ABOUT */

.about {
  background: #0b1220;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.about-image {
  height: 370px;
  border-radius: 10px;
  overflow: hidden;
}

.about-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.about-text p {
  color: var(--gray);
  margin-top: 15px;
  font-size: 14px;
}

/* SKILLS */

.skills-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 18px;
  margin-top: 35px;
}

.skill {
  padding: 25px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 8px;
  transition: .3s;
}

.skill:hover {
  border-color: var(--neon);
  transform: translateY(-5px);
}

.skill h3 {
  font-size: 16px;
  margin-bottom: 10px;
  color: var(--neon);
}

.skill p {
  color: var(--gray);
  font-size: 13px;
}

/* PORTFOLIO */

.portfolio {
  background: #0b1220;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 22px;
  margin-top: 35px;
}

.project {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
}

.project img {
  width: 100%;
  height: 240px;
  object-fit: cover;
  transition: .4s;
}

.project:hover img {
  transform: scale(1.04);
}

.project-info {
  padding: 20px;
}

.project-info p {
  color: var(--gray);
  font-size: 13px;
}

/* SHOP */

.shop-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 20px;
  margin-top: 35px;
}

.product {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
  transition: .3s;
}

.product:hover {
  border-color: var(--neon);
  transform: translateY(-5px);
}

.product img {
  width: 100%;
  height: 220px;
  object-fit: cover;
}

.product-info {
  padding: 18px;
}

.product-info p {
  color: var(--gray);
  font-size: 13px;
}

.price {
  color: var(--neon);
  font-weight: 700;
  margin: 12px 0;
}

.buy-btn {
  width: 100%;
  padding: 12px;
  border: none;
  border-radius: 5px;
  background: var(--blue);
  color: white;
  transition: .3s;
}

.buy-btn:hover {
  background: var(--neon);
  color: #070b14;
}

/* CONTACT */

.contact {
  background: #101827;
  text-align: center;
}

.contact .description {
  margin: auto;
}

.contact-links {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 15px;
  margin-top: 25px;
}

.contact-links a {
  border: 1px solid var(--blue);
  color: var(--neon);
  padding: 10px 22px;
  border-radius: 5px;
  font-size: 13px;
}

.contact-links a:hover {
  background: var(--blue);
  color: white;
}

/* FOOTER */

footer {
  background: #030712;
  text-align: center;
  padding: 30px;
  color: var(--gray);
  font-size: 12px;
}

footer span {
  color: var(--neon);
}

/* RESPONSIVE */

@media(max-width:768px) {
  .nav-links {
    display: none;
  }

  .hero {
    flex-direction: column;
    padding-top: 60px;
  }

  .hero-image {
    width: 100%;
    height: 320px;
  }

  .about-grid {
    grid-template-columns: 1fr;
  }

  .skills-grid,
  .shop-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .project-grid {
    grid-template-columns: 1fr;
  }
}

@media(max-width:480px) {
  .skills-grid,
  .shop-grid {
    grid-template-columns: 1fr;
  }
}
</style>
</head>

<body>

<!-- NAVBAR -->
<header>
<nav>
  <a href="#home" class="logo">NEXORA.</a>

  <ul class="nav-links">
    <li><a href="#home">Home</a></li>
    <li><a href="#about">About</a></li>
    <li><a href="#skills">Skills</a></li>
    <li><a href="#portfolio">Portfolio</a></li>
    <li><a href="#shop">Shop</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>

  <button class="cart-btn" onclick="showCart()">
    Cart (<span id="count">0</span>)
  </button>
</nav>
</header>

<!-- HOME -->
<section class="hero" id="home">

  <div class="hero-content">
    <p class="label">WELCOME TO MY WORLD</p>

    <h1>Hello, I'm <span>Nama Kamu.</span></h1>

    <p class="description">
      Saya adalah seorang kreator yang tertarik pada dunia
      teknologi, desain, kreativitas, dan bisnis digital.
      Saya membangun ide menjadi sesuatu yang bernilai.
    </p>

    <a href="#portfolio" class="primary-btn">
      Explore My Work →
    </a>

    <div class="stats">
      <div>
        <strong>03+</strong>
        <small>Skills</small>
      </div>
      <div>
        <strong>05+</strong>
        <small>Projects</small>
      </div>
      <div>
        <strong>100%</strong>
        <small>Creativity</small>
      </div>
    </div>
  </div>

  <div class="hero-image">
    <img src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=900"
    alt="Workspace">
  </div>

</section>

<!-- ABOUT -->
<section class="about" id="about">
<div class="container about-grid">

  <div class="about-image">
    <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=900"
    alt="About me">
  </div>

  <div class="about-text">
    <p class="label">ABOUT ME</p>
    <h2>Who Am I?</h2>

    <p>
      Halo! Nama saya <b>Nama Kamu</b>.
      Saya memiliki ketertarikan pada teknologi,
      desain, dan pengembangan digital.
    </p>

    <p>
      Saya senang mempelajari hal baru,
      mengembangkan kreativitas, serta menciptakan
      sesuatu yang bermanfaat.
      Website ini menjadi tempat untuk memperkenalkan
      diri, membagikan karya, dan menjual produk.
    </p>

    <a href="#contact" class="primary-btn">
      Contact Me →
    </a>
  </div>

</div>
</section>

<!-- SKILLS -->
<section class="container" id="skills">

  <p class="label">MY ABILITIES</p>
  <h2>Skills & Expertise.</h2>

  <p class="description">
    Kemampuan yang saya miliki dan terus saya kembangkan.
  </p>

  <div class="skills-grid">

    <div class="skill">
      <h3>01. HTML</h3>
      <p>Membangun struktur dasar website.</p>
    </div>

    <div class="skill">
      <h3>02. CSS</h3>
      <p>Membuat desain website yang menarik.</p>
    </div>

    <div class="skill">
      <h3>03. JavaScript</h3>
      <p>Mengembangkan fitur interaktif.</p>
    </div>

    <div class="skill">
      <h3>04. Web Design</h3>
      <p>Menciptakan tampilan modern dan minimalis.</p>
    </div>

    <div class="skill">
      <h3>05. Creativity</h3>
      <p>Mengembangkan ide kreatif dan inovatif.</p>
    </div>

    <div class="skill">
      <h3>06. Digital Business</h3>
      <p>Mengenal dunia bisnis dan pemasaran digital.</p>
    </div>

  </div>
</section>

<!-- PORTFOLIO -->
<section class="portfolio" id="portfolio">
<div class="container">

  <p class="label">MY WORK</p>
  <h2>Selected Projects.</h2>

  <p class="description">
    Beberapa karya dan proyek yang pernah saya buat.
  </p>

  <div class="project-grid">

    <div class="project">
      <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=900"
      alt="Web design">
      <div class="project-info">
        <h3>Website Development</h3>
        <p>Website Design & Development</p>
      </div>
    </div>

    <div class="project">
      <img src="https://images.unsplash.com/photo-1558655146-9f40138edfeb?w=900"
      alt="Creative design">
      <div class="project-info">
        <h3>Creative Design</h3>
        <p>Graphic Design & Branding</p>
      </div>
    </div>

  </div>
</div>
</section>

<!-- SHOP -->
<section class="container" id="shop">

  <p class="label">ONLINE STORE</p>
  <h2>Explore Products.</h2>

  <p class="description">
    Temukan produk pilihan yang tersedia di toko kami.
  </p>

  <div class="shop-grid">

    <div class="product">
      <img src="https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=700"
      alt="Laptop">
      <div class="product-info">
        <h3>Digital Product</h3>
        <p>Produk digital berkualitas.</p>
        <div class="price">Rp150.000</div>
        <button class="buy-btn"
        onclick="addCart('Digital Product',150000)">
        Add to Cart
        </button>
      </div>
    </div>

    <div class="product">
      <img src="https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=700"
      alt="Book">
      <div class="product-info">
        <h3>Creative Collection</h3>
        <p>Koleksi produk kreatif.</p>
        <div class="price">Rp85.000</div>
        <button class="buy-btn"
        onclick="addCart('Creative Collection',85000)">
        Add to Cart
        </button>
      </div>
    </div>

    <div class="product">
      <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=700"
      alt="Watch">
      <div class="product-info">
        <h3>Premium Collection</h3>
        <p>Produk pilihan eksklusif.</p>
        <div class="price">Rp250.000</div>
        <button class="buy-btn"
        onclick="addCart('Premium Collection',250000)">
        Add to Cart
        </button>
      </div>
    </div>

  </div>
</section>

<!-- CONTACT -->
<section class="contact" id="contact">
<div class="container">

  <p class="label">GET IN TOUCH</p>
  <h2>Let's Work Together.</h2>

  <p class="description">
    Tertarik bekerja sama atau membeli produk?
    Hubungi saya melalui kontak berikut.
  </p>

  <div class="contact-links">
    <a href="mailto:emailkamu@gmail.com">Email</a>
    <a href="https://instagram.com/" target="_blank">Instagram</a>
    <a href="https://wa.me/6281234567890" target="_blank">WhatsApp</a>
  </div>

</div>
</section>

<!-- FOOTER -->
<footer>
  <p>© 2026 <span>NEXORA.</span> All Rights Reserved.</p>
  <p>Designed with simplicity & creativity.</p>
</footer>

<script>

// SHOPPING CART

let cart = [];

function addCart(name, price) {
  cart.push({name, price});

  document.getElementById("count").textContent =
  cart.length;

  alert(name + " berhasil ditambahkan!");
}

function showCart() {

  if(cart.length === 0) {
    alert("Keranjang masih kosong.");
    return;
  }

  let total = 0;
  let detail = "KERANJANG BELANJA\n\n";

  cart.forEach((item, index) => {
    detail += (index + 1) + ". " + item.name +
    " - Rp" + item.price.toLocaleString("id-ID") + "\n";

    total += item.price;
  });

  detail += "\nTotal: Rp" + total.toLocaleString("id-ID");

  alert(detail);
}

</script>

</body>
</html>
